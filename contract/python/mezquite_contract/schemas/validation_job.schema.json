{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mezquite.org/contracts/validation_job/1.0.json",
  "title": "ValidationJob",
  "description": "Mensaje encolado por el backend (productor) para el sistema de validacion de imagenes (consumidor). Frontera §6.2 de bitacora_sdd_mezquite.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "image_ref", "captured_at", "lat", "lon", "schema_version"],
  "properties": {
    "observation_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID de la observacion."
    },
    "image_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Clave o URL en StorageProvider. Nunca el binario de la imagen."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 del momento de captura (EXIF)."
    },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "schema_version": { "type": "string", "const": "1.0" }
  }
}
