# ============================================================================
#  Configuración de PRODUCCIÓN — servidor único (CR-014).
#  Copia este archivo a `.env.prod` (NO se versiona) y edita los valores:
#      cp infra/compose/.env.prod.example infra/compose/.env.prod
#      chmod 600 infra/compose/.env.prod
#  🔒 = SECRETO (no lo compartas ni lo subas a git). Nombres exactos = backend/app/config.py.
# ============================================================================

# --- Dominios y TLS (los lee el Caddyfile) ---------------------------------
APP_DOMAIN=app.example.org          # web del voluntario (subdominio)
ADMIN_DOMAIN=admin.example.org      # web-admin / consola (subdominio)
ACME_EMAIL=infra@example.org        # correo para Let's Encrypt (avisos de expiración)

# --- PostgreSQL (las lee la imagen postgis y se reusan en DATABASE_URL) -----
POSTGRES_USER=mezquite
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA   # 🔒
POSTGRES_DB=mezquite

# --- Base de datos para la API (debe COINCIDIR con las tres de arriba) ------
# Host = nombre del servicio compose (`postgres`). Driver psycopg v3.
DATABASE_URL=postgresql+psycopg://mezquite:CAMBIA_ESTA_CONTRASENA@postgres:5432/mezquite   # 🔒

# --- Almacenamiento de imágenes (gate #6: local, en el filesystem del host) -
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
STORAGE_PUBLIC_BASE_URL=/files      # Caddy proxya /files/* a la API (mismo origen)

# --- Cola / broker (§6 inactiva por CR-001) --------------------------------
BROKER=memory                       # no requiere Redis

# --- Seguridad de tokens ----------------------------------------------------
# Genera uno nuevo:  openssl rand -hex 32
AUTH_SECRET=GENERA_UNO_CON_openssl_rand_hex_32   # 🔒

# --- Autenticación (CR-002 / CR-004 W1) ------------------------------------
# `firebase` = Sign in with Google real (público). `mock` = piloto cerrado/interno sin Google.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=tu-proyecto-firebase         # aud/iss esperados al verificar el ID token
# GOOGLE_OAUTH_AUDIENCE=                          # solo si el `aud` difiere del project id

# --- CORS (defensa en profundidad; cada web ya es mismo-origen con su API) --
CORS_ENV=prod                       # fuera de dev: SOLO orígenes explícitos, nunca *
CORS_ALLOW_ORIGINS=https://app.example.org,https://admin.example.org

# --- Privacidad (gate #5: celda pública mínima) ----------------------------
OBFUSCATION_GRID_M=300

# --- Primer administrador (bootstrap idempotente; se puede correr aparte) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CAMBIA_TRAS_EL_PRIMER_INGRESO   # 🔒
BOOTSTRAP_ADMIN_EMAIL=admin@example.org                  # único rol con email (gate #2)

# --- SMTP (opcional): reset de contraseña del administrador -----------------
# Si se omite, el reset degrada a "lo hace el administrador" (no bloquea el arranque).
# SMTP_HOST=smtp.example.org         # 🔒
# SMTP_PORT=587
# SMTP_USER=no-reply@example.org     # 🔒
# SMTP_PASSWORD=                      # 🔒
# SMTP_FROM=no-reply@example.org
